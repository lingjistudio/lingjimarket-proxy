  "outbounds": [
    { "type": "direct", "tag": "direct-out" },
    { "type": "block", "tag": "reject" }
  ],

  "route": {
    "default_domain_resolver": "cloudflare-dns",
    "rule_set": [
      {
        "type": "remote",
        "tag": "geosite-cn",
        "format": "source",
        "url": "https://cdn.jsdelivr.net/gh/Loyalsoldier/v2ray-rules-dat@release/geosite.dat"
      },
      {
        "type": "remote",
        "tag": "geoip-cn",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/Loyalsoldier/v2ray-rules-dat@release/geoip.db"
      },
      {
        "type": "remote",
        "tag": "geosite-ads",
        "format": "source",
        "url": "https://cdn.jsdelivr.net/gh/Loyalsoldier/v2ray-rules-dat@release/geosite.dat"
      }
    ],
    "rules": [
      // ========== Tier 1: 拦截广告 ==========
      { "rule_set": ["geosite-ads:category-ads-all"], "action": "reject" },

      // ========== Tier 2: 拦截统计/遥测/追踪 ==========
      { "domain_suffix": [".google-analytics.com", ".googletagmanager.com", ".doubleclick.net", ".googleoptimize.com"], "action": "reject" },
      { "domain": ["connect.facebook.net", "pixel.facebook.com"], "action": "reject" },
      { "domain_suffix": [".appsflyersdk.com", ".branch.io"], "action": "reject" },
      { "domain": ["analytics.tiktok.com", "log.tiktokv.com", "log2.musical.ly", "ib.tiktokv.com", "mon.musical.ly", "bytedapm.com"], "action": "reject" },
      { "domain_suffix": [".ads-twitter.com"], "action": "reject" },
      { "domain": ["static.ads-twitter.com", "tellapart.com"], "action": "reject" },

      // ========== Tier 3: CDN/静态/媒体资源直连（海外主机可直达，节省代理带宽） ==========
      // Instagram CDN — 图片/视频/静态资源
      { "domain_suffix": [".cdninstagram.com", ".fbcdn.net", ".fbcdn.com"], "action": "route", "outbound": "direct-out" },
      { "domain_suffix": [".akamaihd.net"], "action": "route", "outbound": "direct-out" },
      // Twitter CDN — 图片/头像/视频/静态资源
      { "domain_suffix": [".twimg.com", ".cms-twdigitalassets.com"], "action": "route", "outbound": "direct-out" },
      // TikTok CDN — 视频/图片/静态资源
      { "domain_suffix": [".tiktokcdn.com", ".tiktokcdn-eu.com", ".tiktokcdn-us.com", ".tiktokeu-cdn.com", ".tiktokrow-cdn.com"], "action": "route", "outbound": "direct-out" },
      { "domain_suffix": [".ttcdn-us.com", ".ttlivecdn.com", ".ttwstatic.com", ".muscdn.com"], "action": "route", "outbound": "direct-out" },
      // 通用 CDN / 字体 / 公共静态资源
      { "domain_suffix": [".akamaized.net", ".edgesuite.net", ".edgekey.net", ".fastly.net", ".fastlylb.net"], "action": "route", "outbound": "direct-out" },
      { "domain_suffix": [".googleapis.com", ".gstatic.com"], "action": "route", "outbound": "direct-out" },
      { "domain": ["fonts.googleapis.com", "fonts.gstatic.com", "www.gstatic.com"], "action": "route", "outbound": "direct-out" },
      // Cloudflare 公共 CDN
      { "domain": ["cdnjs.cloudflare.com", "ajax.cloudflare.com"], "action": "route", "outbound": "direct-out" },

      // ========== Tier 4: 国内流量直连 ==========
      { "rule_set": ["geosite-cn:cn"], "action": "route", "outbound": "direct-out" },
      { "rule_set": ["geoip-cn:cn"], "action": "route", "outbound": "direct-out" },

      // ========== Tier 5: 私有 IP 直连 ==========
      { "ip_is_private": true, "action": "route", "outbound": "direct-out" },

      // ========== Tier 6: inbound → outbound 一对一映射 ==========
      // 未被 CDN/直连规则拦截的流量（即核心社交平台 API/认证 + 人机验证）走代理出站
      { "type": "logical", "mode": "and", "action": "route", "rules": [{ "inbound": ["in#0"] }], "outbound": "out#0" },
      { "type": "logical", "mode": "and", "action": "route", "rules": [{ "inbound": ["in#1"] }], "outbound": "out#1" },
      { "type": "logical", "mode": "and", "action": "route", "rules": [{ "inbound": ["in#2"] }], "outbound": "out#2" },
      { "type": "logical", "mode": "and", "action": "route", "rules": [{ "inbound": ["in#3"] }], "outbound": "out#3" },
      { "type": "logical", "mode": "and", "action": "route", "rules": [{ "inbound": ["in#4"] }], "outbound": "out#4" },
      { "type": "logical", "mode": "and", "action": "route", "rules": [{ "inbound": ["in#5"] }], "outbound": "out#5" },
      { "type": "logical", "mode": "and", "action": "route", "rules": [{ "inbound": ["in#6"] }], "outbound": "out#6" },
      { "type": "logical", "mode": "and", "action": "route", "rules": [{ "inbound": ["in#7"] }], "outbound": "out#7" },
      { "type": "logical", "mode": "and", "action": "route", "rules": [{ "inbound": ["in#8"] }], "outbound": "out#8" },
      { "type": "logical", "mode": "and", "action": "route", "rules": [{ "inbound": ["in#9"] }], "outbound": "out#9" },
      { "type": "logical", "mode": "and", "action": "route", "rules": [{ "inbound": ["in#10"] }], "outbound": "out#10" },
      { "type": "logical", "mode": "and", "action": "route", "rules": [{ "inbound": ["in#11"] }], "outbound": "out#11" },
      { "type": "logical", "mode": "and", "action": "route", "rules": [{ "inbound": ["in#12"] }], "outbound": "out#12" },
      { "type": "logical", "mode": "and", "action": "route", "rules": [{ "inbound": ["in#13"] }], "outbound": "out#13" },
      { "type": "logical", "mode": "and", "action": "route", "rules": [{ "inbound": ["in#14"] }], "outbound": "out#14" },
      { "type": "logical", "mode": "and", "action": "route", "rules": [{ "inbound": ["in#15"] }], "outbound": "out#15" },
      { "type": "logical", "mode": "and", "action": "route", "rules": [{ "inbound": ["in#16"] }], "outbound": "out#16" },
      { "type": "logical", "mode": "and", "action": "route", "rules": [{ "inbound": ["in#17"] }], "outbound": "out#17" },
      { "type": "logical", "mode": "and", "action": "route", "rules": [{ "inbound": ["in#18"] }], "outbound": "out#18" },
      { "type": "logical", "mode": "and", "action": "route", "rules": [{ "inbound": ["in#19"] }], "outbound": "out#19" },
      { "type": "logical", "mode": "and", "action": "route", "rules": [{ "inbound": ["in#20"] }], "outbound": "out#20" },
      { "type": "logical", "mode": "and", "action": "route", "rules": [{ "inbound": ["in#21"] }], "outbound": "out#21" },
      { "type": "logical", "mode": "and", "action": "route", "rules": [{ "inbound": ["in#22"] }], "outbound": "out#22" },
      { "type": "logical", "mode": "and", "action": "route", "rules": [{ "inbound": ["in#23"] }], "outbound": "out#23" },
      { "type": "logical", "mode": "and", "action": "route", "rules": [{ "inbound": ["in#24"] }], "outbound": "out#24" },
      { "type": "logical", "mode": "and", "action": "route", "rules": [{ "inbound": ["in#25"] }], "outbound": "out#25" },
      { "type": "logical", "mode": "and", "action": "route", "rules": [{ "inbound": ["in#26"] }], "outbound": "out#26" },
      { "type": "logical", "mode": "and", "action": "route", "rules": [{ "inbound": ["in#27"] }], "outbound": "out#27" },
      { "type": "logical", "mode": "and", "action": "route", "rules": [{ "inbound": ["in#28"] }], "outbound": "out#28" },
      { "type": "logical", "mode": "and", "action": "route", "rules": [{ "inbound": ["in#29"] }], "outbound": "out#29" },
      { "type": "logical", "mode": "and", "action": "route", "rules": [{ "inbound": ["in#30"] }], "outbound": "out#30" },
      { "type": "logical", "mode": "and", "action": "route", "rules": [{ "inbound": ["in#31"] }], "outbound": "out#31" },
      { "type": "logical", "mode": "and", "action": "route", "rules": [{ "inbound": ["in#32"] }], "outbound": "out#32" },
      { "type": "logical", "mode": "and", "action": "route", "rules": [{ "inbound": ["in#33"] }], "outbound": "out#33" },
      { "type": "logical", "mode": "and", "action": "route", "rules": [{ "inbound": ["in#34"] }], "outbound": "out#34" },
      { "type": "logical", "mode": "and", "action": "route", "rules": [{ "inbound": ["in#35"] }], "outbound": "out#35" },
      { "type": "logical", "mode": "and", "action": "route", "rules": [{ "inbound": ["in#36"] }], "outbound": "out#36" },
      { "type": "logical", "mode": "and", "action": "route", "rules": [{ "inbound": ["in#37"] }], "outbound": "out#37" },
