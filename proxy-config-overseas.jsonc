{
  // ============================================================
  // lingjimarket-proxy — 海外主机配置
  // ============================================================
  // 场景：主机在海外，出站为代理节点
  // 策略：
  //   - 社交平台核心域名（API/认证/人机验证）→ 走代理出站（维持 IP 一致性）
  //   - CDN/静态资源/媒体 → 直连（最大节省带宽，图片视频占流量 70%+）
  //   - 广告/统计/遥测 → 拦截
  //   - 国内流量 → 直连
  // ============================================================

  "log": {
    "level": "warn",
    "timestamp": true,
    "output": "log/proxy.log"
  },

  "dns": {
    "servers": [
      { "type": "udp", "tag": "cloudflare-dns", "server": "1.1.1.1" },
      { "type": "udp", "tag": "google-dns", "server": "8.8.8.8" }
    ],
    "strategy": "prefer_ipv4"
  },

  "inbounds": [
    { "type": "socks", "tag": "in#0",  "listen": "0.0.0.0", "listen_port": 44400, "users": [] },
    { "type": "socks", "tag": "in#1",  "listen": "0.0.0.0", "listen_port": 44401, "users": [] },
    { "type": "socks", "tag": "in#2",  "listen": "0.0.0.0", "listen_port": 44402, "users": [] },
    { "type": "socks", "tag": "in#3",  "listen": "0.0.0.0", "listen_port": 44403, "users": [] },
    { "type": "socks", "tag": "in#4",  "listen": "0.0.0.0", "listen_port": 44404, "users": [] },
